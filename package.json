{
  "name": "documate",
  "version": "2.1.0",
  "description": "AI-powered code intelligence platform - agentic documentation, debt prediction, and auto-fixing",
  "main": "dist/index.js",
  "bin": {
    "documate": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "documentation",
    "code-analysis",
    "developer-tools",
    "productivity",
    "cli",
    "ai-agent",
    "technical-debt",
    "code-intelligence",
    "auto-documentation",
    "typescript",
    "javascript",
    "python"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^8.57.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@octokit/rest": "^20.0.2",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "diff": "^5.2.0",
    "eventemitter3": "^5.0.1",
    "figures": "^6.0.1",
    "glob": "^10.3.10",
    "inquirer": "^9.2.12",
    "ora": "^8.0.0",
    "simple-git": "^3.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
