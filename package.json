{
  "name": "documate",
  "version": "1.0.0",
  "description": "Intelligent code documentation generator and understanding tool - solving the #1 developer pain point",
  "main": "dist/index.js",
  "bin": {
    "documate": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "documentation",
    "code-analysis",
    "developer-tools",
    "productivity",
    "cli",
    "typescript",
    "javascript",
    "python",
    "code-understanding"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "glob": "^10.3.10",
    "boxen": "^7.1.1",
    "cli-table3": "^0.6.3",
    "figures": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
